<%= form_with model: [@sprint.project, @sprint, @task], local: true do |f| %>
  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, required: true %>
  </div>

  <div class="field">
    <%= f.label :description %>
    <%= f.text_area :description, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :task_type %>
    <%= f.select :task_type, Task.task_types.keys.map { |type| [type.humanize, type] }, {}, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :status %>
    <%= f.select :status, Task.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :priority %>
    <%= f.select :priority, Task.priorities.keys.map { |p| [p.humanize, p] }, {}, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :start_date %>
    <%= f.date_field :start_date, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :due_date %>
    <%= f.date_field :due_date, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :end_date %>
    <%= f.date_field :end_date, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :assignee_id, "Assignee" %>
    <%= f.collection_select :assignee_id, User.all, :id, :name, include_blank: true, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :points %>
    <%= f.text_field :points %>
  </div>

  <%= f.submit @task.new_record? ? "Create Task" : "Update Task", class: "btn btn-primary" %>
<% end %>
