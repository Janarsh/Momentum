<h1><%= @project.name %></h1>
<p><%= @project.description %></p>

<h2>Sprints</h2>
<%= link_to "New Sprint", new_project_sprint_path(@project), class: "btn btn-primary" %>

<ul>
  <% @project.sprints.each do |sprint| %>
    <li>
      <%= link_to sprint.name, project_sprint_path(@project, sprint) %>
      <%= link_to "Edit", edit_project_sprint_path(@project, sprint) %> |
      <%= link_to "Delete", project_sprint_path(@project, sprint), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
    </li>
  <% end %>
</ul>

<%= link_to "Back to Projects", projects_path %>
